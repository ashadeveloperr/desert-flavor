  "bidderModifiers": {
    "_note": "입찰자가 매각 보상으로 주는 영구 모디파이어(결정 BM1~BM4). pool = 입찰자 id(전용) 또는 general(범용). weight = 같은 목록 안에서 뽑힐 비중(기본 1). maxStacks = 캠페인에서 받을 수 있는 최대 횟수(그만큼 받으면 더 뽑히지 않음, 없으면 defaultMaxStacks). 효과 형식은 지역 모디파이어와 같다(곱연산).",
    "exclusiveChance": 0.7,
    "defaultMaxStacks": 5,
    "definitions": [
      { "id": "ore", "pool": "industrialist", "effects": {"oreOutputMultiplier": 1.08} },
      { "id": "processingOutput", "pool": "industrialist", "effects": {"processingOutputMultiplier": 1.05} },
      { "id": "processingInput", "pool": "industrialist", "effects": {"processingInputMultiplier": 0.95} },
      { "id": "constructionSlot", "pool": "industrialist", "weight": 0.25, "maxStacks": 2, "effects": {"extraConstructionSlots": 1} },
      { "id": "grain", "pool": "farmer", "effects": {"grainOutputMultiplier": 1.06} },
      { "id": "farmGoods", "pool": "farmer", "effects": {"farmGoodsOutputMultiplier": 1.06} },
      { "id": "cropGuard", "pool": "farmer", "maxStacks": 3, "effects": {"locustDamageMultiplier": 0.8, "blightDamageMultiplier": 0.8} },
      { "id": "farmWater", "pool": "farmer", "effects": {"farmWaterDemandMultiplier": 0.95} },
      { "id": "sellPrice", "pool": "distributor", "effects": {"sellPriceMultiplier": 1.08} },
      { "id": "buyPrice", "pool": "distributor", "effects": {"purchasePriceMultiplier": 0.92} },
      { "id": "spoilage", "pool": "distributor", "maxStacks": 3, "effects": {"spoilageMultiplier": 0.85} },
      { "id": "storage", "pool": "distributor", "effects": {"storageMultiplier": 1.1} },
      { "id": "stoneCost", "pool": "builder", "effects": {"stoneCostMultiplier": 0.94} },
      { "id": "buildTime", "pool": "builder", "effects": {"constructionTimeMultiplier": 0.92} },
      { "id": "stoneOutput", "pool": "builder", "effects": {"stoneOutputMultiplier": 1.08} },
      { "id": "wellSupply", "pool": "waterBroker", "effects": {"wellSupplyMultiplier": 1.06} },
      { "id": "canalLoss", "pool": "waterBroker", "maxStacks": 3, "effects": {"canalLossMultiplier": 0.85} },
      { "id": "sandstorm", "pool": "waterBroker", "maxStacks": 3, "effects": {"sandstormDamageMultiplier": 0.8} },
      { "id": "waterTank", "pool": "waterBroker", "maxStacks": 3, "effects": {"waterTankCapacityMultiplier": 1.2} },
      { "id": "upkeep", "pool": "developer", "effects": {"upkeepMultiplier": 0.96} },
      { "id": "houseArrival", "pool": "developer", "effects": {"arrivalMultiplier": 1.1} },
      { "id": "warehouse", "pool": "developer", "maxStacks": 3, "effects": {"warehouseStorageMultiplier": 1.15} },
      { "id": "arrival", "pool": "colonist", "effects": {"arrivalMultiplier": 1.1} },
      { "id": "ration", "pool": "colonist", "effects": {"foodPerResidentMultiplier": 0.95} },
